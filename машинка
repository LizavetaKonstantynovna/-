
import numpy as np
import matplotlib.pyplot as plt
from PIL import Image
from sklearn.datasets import load_iris
import itertools

# Шаг 1: Определение оптимального количества кластеров (метод локтя)
# Метод локтя заключается в следующем: мы выполняем кластеризацию для
# различных значений k и строим график зависимости суммарной внутрикластерной дисперсии от количества кластеров

# •  Формула: WCSS = ∑ᵢ ∑ₓᵢ∈Cᵢ ||xᵢ - μᵢ||², где:
#   •  i - индекс кластера (от 1 до k, где k - количество кластеров).
#   •  xᵢ - точка данных, принадлежащая кластеру Cᵢ.
#   •  μᵢ - центроид кластера Cᵢ.
#   •  ||xᵢ - μᵢ||² - квадрат евклидова расстояния между точкой xᵢ и центроидом μᵢ.


def method_lokty(data, feature_names, max_clusters=10):
    wcss = []  # Within-Cluster Sum of Squares
    for i in range(1, max_clusters + 1):
        kmeans = KMeans(data, n_clusters=i)
        kmeans.fit()
        wcss.append(kmeans.inertia_())
    plt.plot(range(1, max_clusters + 1), wcss, marker='o')
    plt.title('Метод локтя для определения оптимального количества кластеров')
    plt.xlabel('Количество кластеров')
    plt.ylabel('WCSS')
    plt.grid(True)
    plt.show()

    elbow = 3
    return elbow


# Шаг 2: Реализация K-Means
class KMeans:
    def __init__(self, data, n_clusters=3, max_iters=100):
        self.data = data
        self.n_clusters = n_clusters
        self.max_iters = max_iters
        self.centroids = None
        self.labels = None
        self.history = [] # Список для хранения координат центроидов на каждой итерации

    def initialize_centroids(self):
        np.random.seed(42)
        indices = np.random.choice(len(self.data), self.n_clusters, replace=False)
        self.centroids = self.data[indices]
        self.history.append(self.centroids.copy()) #чтобы сохранить текущее состояние центроидов, а не ссылку на них.

    def assign_labels(self): #штука для нахождения растояния точек от центроид для дальнейшего расставления))
        self.labels = np.zeros(len(self.data), dtype=int)
        for i, point in enumerate(self.data):
            distances = np.linalg.norm(point - self.centroids, axis=1)
            self.labels[i] = np.argmin(distances)

    def update_centroids(self):
        new_centroids = np.zeros_like(self.centroids)
        for i in range(self.n_clusters):
            cluster_points = self.data[self.labels == i]
            if len(cluster_points) > 0:
                new_centroids[i] = np.mean(cluster_points, axis=0)
            else:
                new_centroids[i] = self.centroids[i]

        self.centroids = new_centroids
        self.history.append(self.centroids.copy())

    def fit(self):
        self.initialize_centroids()

        for _ in range(self.max_iters):
            old_centroids = self.centroids.copy()
            self.assign_labels()
            self.update_centroids()

            if np.allclose(old_centroids, self.centroids):
                break

    def inertia_(self):
        inertia = 0
        for i, point in enumerate(self.data):
            centroid = self.centroids[self.labels[i]]
            inertia += np.linalg.norm(point - centroid)**2
        return inertia

    def draw_clusters(self, feature_x, feature_y, iteration):
        plt.figure(figsize=(8, 6))
        colors = ['r', 'g', 'b', 'c', 'm', 'y', 'k']

        for i in range(self.n_clusters):
            cluster_points = self.data[self.labels == i]
            plt.scatter(cluster_points[:, feature_x], cluster_points[:, feature_y], c=colors[i % len(colors)], label=f'Кластер {i+1}')

        plt.scatter(self.centroids[:, feature_x], self.centroids[:, feature_y], marker='x', s=200, linewidths=3, color='black', label='Центроиды')
        plt.xlabel(iris.feature_names[feature_x])
        plt.ylabel(iris.feature_names[feature_y])
        plt.title(f'K-Means: Итерация {iteration+1}')
        plt.legend()
        plt.grid(True)

        plt.savefig(f'kmeans_iteration_{iteration+1}.png')
        plt.close()


# Шаг 3: Вывод всех возможных проекций

def show(data, kmeans):

    n_features = data.shape[1]
    feature_names = iris.feature_names

    import itertools
    for i, j in itertools.combinations(range(n_features), 2):
        plt.figure(figsize=(8, 6))
        colors = ['r', 'g', 'b', 'c', 'm', 'y', 'k']

        for k in range(kmeans.n_clusters):
            cluster_points = data[kmeans.labels == k]
            plt.scatter(cluster_points[:, i], cluster_points[:, j], c=colors[k % len(colors)], label=f'Кластер {k+1}')
        plt.scatter(kmeans.centroids[:, i], kmeans.centroids[:, j], marker='x', s=200, linewidths=3, color='black', label='Центроиды')
        plt.xlabel(feature_names[i])
        plt.ylabel(feature_names[j])
        plt.title(f'Проекция: {feature_names[i]} vs {feature_names[j]}')
        plt.legend()
        plt.grid(True)
        plt.show()


if __name__ == "__main__":

    iris = load_iris()
    data = iris.data

    # Шаг 1: Определение оптимального количества кластеров
    optimal_clusters = method_lokty(data, iris.feature_names)
    print(f"Оптимальное количество кластеров: {optimal_clusters}")

    # Шаг 2: ка-минс
    kmeans = KMeans(data, n_clusters=optimal_clusters, max_iters=100)

    for iteration in range(5):
        kmeans.fit()
        kmeans.draw_clusters(0, 1, iteration)
    print("Визуализация кластеризации завершена. Изображения сохранены.")

    # Вывод проекций
    show(data, kmeans)
    print("Вывод всех проекций завершен.")
